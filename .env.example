# Copy this file to .env and change the values. Never commit .env.

POSTGRES_PASSWORD=change-me
# Used by the backend and the tests when they run on the host.
# Inside Docker Compose, the server gets its own DATABASE_URL.
DATABASE_URL=postgres://toolport:change-me@localhost:5432/toolport

# localhost uses a local Caddy certificate. A real domain gets a Let's Encrypt certificate.
TOOLPORT_DOMAIN=localhost
RUST_LOG=info

# Time limit for one upstream API call of an MCP tool. The default is 10000 (10 seconds).
UPSTREAM_TIMEOUT_MS=10000

# Seconds between two runs of the spec check. Each run re-checks the APIs whose daily check
# is on and whose last check is older than 24 hours. The default is 3600 (one hour).
SPEC_CHECK_INTERVAL_SECS=3600

# Tool calls per minute for each MCP token. A token can send a burst of the calls of
# 10 seconds. 0 turns the limit off. The default is 60.
RATE_LIMIT_PER_MINUTE=60

# Tool calls per minute for all MCP tokens of one user together, on all servers of the user.
# The burst is the calls of 10 seconds. 0 turns the limit off. The default is 300.
USER_RATE_LIMIT_PER_MINUTE=300

# The URL you open in the browser when the backend and Vite run on the host.
# Inside Docker Compose, the server uses https://$TOOLPORT_DOMAIN instead.
PUBLIC_URL=http://localhost:5173

# Signs the JWTs. Make one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-the-output-of-openssl-rand-hex-32

# Encrypts the upstream API secrets. Make one with: openssl rand -hex 32
SECRETS_KEY=replace-me-with-the-output-of-openssl-rand-hex-32

# Set to true only in local dev, to let tools call APIs on 127.0.0.1
ALLOW_LOCAL_UPSTREAM=false

# From your GitHub OAuth app: https://github.com/settings/developers
# Callback URL for Docker Compose: https://localhost/auth/github/callback
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me

# Stripe test mode. Payments are off when one of the two is empty.
# The secret key comes from https://dashboard.stripe.com/test/apikeys (sk_test_ or rk_test_).
# Never use a live key here. scripts/stripe-webhook-secret.sh fills STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
