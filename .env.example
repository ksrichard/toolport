# Copy this file to .env and change the values. Never commit .env.

POSTGRES_PASSWORD=change-me
# Used by the backend and the tests when they run on the host.
# Inside Docker Compose, the server gets its own DATABASE_URL.
DATABASE_URL=postgres://toolport:change-me@localhost:5432/toolport

# localhost uses a local Caddy certificate. A real domain gets a Let's Encrypt certificate.
TOOLPORT_DOMAIN=localhost
RUST_LOG=info

# Used from milestone 4 and 6.
JWT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
