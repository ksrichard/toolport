# Copy this file to .env and change the values. Never commit .env.

POSTGRES_PASSWORD=change-me
# Used by the backend and the tests when they run on the host.
# Inside Docker Compose, the server gets its own DATABASE_URL.
DATABASE_URL=postgres://toolport:change-me@localhost:5432/toolport

# localhost uses a local Caddy certificate. A real domain gets a Let's Encrypt certificate.
TOOLPORT_DOMAIN=localhost
RUST_LOG=info

# Time limit for one upstream API call of an MCP tool. The default is 10000 (10 seconds).
UPSTREAM_TIMEOUT_MS=10000

# The URL you open in the browser when the backend and Vite run on the host.
# Inside Docker Compose, the server uses https://$TOOLPORT_DOMAIN instead.
PUBLIC_URL=http://localhost:5173

# Signs the JWTs. Make one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-the-output-of-openssl-rand-hex-32

# From your GitHub OAuth app: https://github.com/settings/developers
# Callback URL for Docker Compose: https://localhost/auth/github/callback
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
